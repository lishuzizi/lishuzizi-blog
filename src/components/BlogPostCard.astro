---
type Props = {
  title: string;
  slug: string;
  excerpt: string;
  date: Date;
  tags?: string[];
};

const { title, slug, excerpt, date, tags = [] } = Astro.props;
---

<article
  class="article-card group relative overflow-hidden rounded-[1.5rem]"
>
  <a href={`/blog/${slug}`} class="flex min-h-60 flex-col p-6 sm:p-7">
    <div class="mb-8 flex items-center justify-between gap-3">
      <p class="text-xs font-medium uppercase tracking-[.14em] text-gray-400 dark:text-gray-500">
        {date.toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </p>
      <span class="article-arrow" aria-hidden="true">↗</span>
    </div>
    <h2 class="mb-3 text-xl font-semibold leading-snug text-gray-900 transition-colors line-clamp-2 dark:text-gray-100 sm:text-2xl">
      {title}
    </h2>
    <p class="text-sm leading-7 text-gray-500 line-clamp-2 dark:text-gray-400">
      {excerpt}
    </p>
    {tags.length > 0 && <div class="mt-auto flex flex-wrap gap-2 pt-6">{tags.slice(0, 3).map((tag) => <span class="article-tag">#{tag}</span>)}</div>}
  </a>
</article>
