---
import { SITE_TITLE } from "@/consts";

const today = new Date();
---

<footer
  class="w-full border-t border-white/30 py-9 dark:border-white/10"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 text-sm text-gray-500 dark:text-gray-400 sm:flex-row"
  >
    <p>&copy; {today.getFullYear()} {SITE_TITLE}. 用心记录，慢慢生长。</p>
    <a href="#top" class="transition-colors hover:text-primary-600 dark:hover:text-primary-400">回到顶部 ↑</a>
  </div>
</footer>
