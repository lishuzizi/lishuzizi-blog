---
import { getCollection } from "astro:content";
import Hero from "@/components/Hero.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Layout from "@/layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="李树孳孳">
  <Hero postCount={posts.length} />

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-6 sm:pb-28">
    <div class="section-heading mb-8 flex items-end justify-between gap-5">
      <div>
        <p class="section-kicker">RECENT WRITING</p>
        <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">最近写下的</h2>
      </div>
      <a
        href="/blog"
        class="all-posts-link text-sm font-medium"
      >
        全部文章 <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        posts.slice(0, 4).map((post) => (
          <BlogPostCard
            slug={post.id}
            title={post.data.title}
            excerpt={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="text-center text-gray-400 py-20">
          暂无文章，敬请期待
        </p>
      )
    }
  </section>
</Layout>
