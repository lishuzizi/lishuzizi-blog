---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import RightSidebar from "@/components/RightSidebar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

const { title = SITE_TITLE, description = SITE_DESCRIPTION, sidebar = false } = Astro.props;
---

<html lang="zh-CN" class="!overflow-x-hidden" style="overflow-x:clip !important">
  <head>
    <BaseHead {title} {description} />
    <script is:inline>
      var saved = localStorage.getItem("theme");
      if (saved === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body id="top"
    class="text-gray-900 dark:text-gray-100 !overflow-x-hidden transition-colors duration-300"
    style="overflow-x:clip !important"
  >
    <div id="bg-wrap" class="fixed inset-0 overflow-hidden" aria-hidden="true">
      <div id="bg-image"></div>
      <div id="bg-overlay"></div>
      <div class="ambient ambient-one"></div>
      <div class="ambient ambient-two"></div>
      <div class="noise"></div>
    </div>

    <header class="fixed top-0 w-full z-[9999]">
      <Navbar />
    </header>
    <main class="pt-24 min-h-screen relative z-[1]">
      {sidebar ? (
        <div class="max-w-6xl mx-auto px-4 lg:px-6 lg:flex lg:gap-8">
          <div class="flex-1 min-w-0"><slot /></div>
          <aside style="position:sticky;top:7rem;height:calc(100vh-7rem);width:288px;flex-shrink:0;align-self:flex-start" data-back-to-home>
            <RightSidebar />
          </aside>
        </div>
      ) : (
        <slot />
      )}
    </main>
    <footer class="relative z-[1]"><Footer /></footer>

    <script is:inline>
      (function(){
        // ------- 主题切换联动背景 + 遮罩 -------
        var bgImage = document.getElementById("bg-image");
        var overlay = document.getElementById("bg-overlay");
        var DARK_BG = "/bg.jpg", LIGHT_BG = "/bg-light.jpg";
        function isDark(){ return document.documentElement.classList.contains("dark"); }
        function updateTheme(){
          if(isDark()){
            if(bgImage) bgImage.style.backgroundImage = "url(" + DARK_BG + ")";
            if(overlay) overlay.style.background = "rgba(0,0,0,0.55)";
          } else {
            if(bgImage) bgImage.style.backgroundImage = "url(" + LIGHT_BG + ")";
            if(overlay) overlay.style.background = "rgba(0,0,0,0.15)";
          }
        }
        updateTheme();
        if(overlay || bgImage){
          var obs = new MutationObserver(function(m){
            for(var i=0;i<m.length;i++){ if(m[i].attributeName==="class"){ updateTheme(); break; } }
          });
          obs.observe(document.documentElement, {attributes:true});
        }

      })();

      // ------- 后退键逻辑 -------
      // 顶层页面(/blog, /log, /about, /projects) → 后退回首页
      // 深层页面(/blog/某篇) → 后退正常(回到博客列表)
      if (document.querySelector('[data-back-to-home]')) {
        var _path = window.location.pathname.replace(/\/$/, '');
        var _segs = _path.split('/').filter(Boolean);
        // 只有一段路径(如 /blog)才是顶层，两段或以上(如 /blog/post)是深层
        if (_segs.length <= 1) {
          var _canGoHome = true;
          history.pushState({ home: true }, '');
          window.addEventListener('popstate', function () {
            if (_canGoHome) {
              _canGoHome = false;
              window.location.href = '/';
            }
          });
        }
      }
    </script>
  </body>
</html>
